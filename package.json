{
  "name": "omni_frontend",
  "private": true,
  "scripts": {
    "build": "NEXT_IGNORE_TYPE_ERRORS=true NEXTJS_SKIP_ESLINT=1 next build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
