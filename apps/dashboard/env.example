# Production/Development flags
IS_PRODUCTION=false

# API URLs
BASE_API_URL_PROD=https://your-api-domain.com
BASE_API_URL_DEV=http://localhost:3000

# Socket URLs
BASE_SOCKET_URL_PROD=wss://your-socket-domain.com
BASE_SOCKET_URL_DEV=ws://localhost:3000

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Session Configuration
SESSION_SECRET=your-session-secret-key 